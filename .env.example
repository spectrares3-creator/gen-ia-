# Copie ce fichier en ".env" et remplis ta vraie cle API.
# NE JAMAIS committer le fichier ".env" (contenant la vraie cle) dans Git.

GEMINI_API_KEY=colle-ici-ta-cle-gemini

# Cle secrete que TON site devra envoyer pour prouver qu'il a le droit
# d'appeler ce serveur (evite que n'importe qui sur internet utilise ton
# quota gratuit). Choisis une chaine longue et aleatoire.
GEN_APP_SECRET=change-moi-en-quelque-chose-de-long-et-aleatoire

# Port d'ecoute du serveur (Render le fournit automatiquement,
# ce n'est utile qu'en local)
PORT=3000
